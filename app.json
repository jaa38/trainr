{
  "expo": {
    "name": "TRAINR",
    "slug": "trainr-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "trainr",
    "userInterfaceStyle": "automatic",

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.trainr.mobile",
      "icon": {
        "light": "./assets/icons/lightModeAppIcon.png",
        "dark": "./assets/icons/darkModeAppIcon.png"
      }
    },

    "android": {
      "package": "com.trainr.mobile",
      "icon": "./assets/icons/lightModeAppIcon.png"
    },

    "web": {
      "bundler": "metro"
    },

    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash/lightSplash.png",

          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/splash/darkSplash.png"
          },

          "enableFullScreenImage_legacy": true
        }
      ]
    ]
  }
}
