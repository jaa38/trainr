{
  "expo": {
    "name": "TRAINR",
    "slug": "trainr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icons/lightModeAppIcon.png",
    "scheme": "trainr",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/images/icons/lightModeAppIcon.png",
        "dark": "./assets/images/icons/darkModeAppIcon.png"
      },
      "bundleIdentifier": "com.jaa38.trainr"
    },
    "android": {
      "icon": "./assets/images/icons/lightModeAppIcon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icons/lightModeAppIcon.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icons/lightModeAppIcon.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash/lightSplash.png",
          "imageWidth": 320,
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/images/splash/darkSplash.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TRAINR needs access to your photos so you can add a profile picture.",
          "cameraPermission": "TRAINR needs camera access so you can take a profile picture.",
          "microphonePermission": false
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-web-browser"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
