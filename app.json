{
  "expo": {
    "name": "TRAINR",
    "slug": "trainr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icons/lightModeAppIcon.png",
    "scheme": "trainr",
    "userInterfaceStyle": "automatic",

    "ios": {
      "icon": {
        "light": "./assets/images/icons/lightModeAppIcon.png",
        "dark": "./assets/images/icons/darkModeAppIcon.png"
      }
    },
    "android": {
      "icon": "./assets/images/icons/lightModeAppIcon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icons/lightModeAppIcon.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icons/lightModeAppIcon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash/lightSplash.png",
          "imageWidth": 320,
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/images/splash/darkSplash.png"
          }
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
